# Copy to .env and fill in, OR run `offboard setup` to generate this automatically.
OFFBOARD_CLIENT_ID=00000000-0000-0000-0000-000000000000
OFFBOARD_CLIENT_SECRET=your-client-secret
OFFBOARD_TENANT_ID=00000000-0000-0000-0000-000000000000
OFFBOARD_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
# Optional: public client ID for interactive device-code login.
# Leave blank to use the built-in default (Azure CLI public client).
OFFBOARD_PUBLIC_CLIENT_ID=